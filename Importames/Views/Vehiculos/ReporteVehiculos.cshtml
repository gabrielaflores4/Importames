@model List<Importames.Models.VehiculoModel>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Vehículos</title>
    <style>
            @@media print {
                * {
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }

                #contenedor-boton {
                    display: none !important;
                }
            }
    </style>
</head>
<body style="font-family: Arial, sans-serif; background: white; margin: 0; padding: 20px;">

    <div id="contenedor-boton" style="text-align: right; margin-bottom: 20px;">
        <button onclick="imprimirReporte()" style="padding: 10px 20px; font-size: 16px; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 5px; font-weight: bold;">
           Guardar PDF / Imprimir
        </button>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #94a3b8; padding-bottom: 15px; margin-bottom: 20px;">
        <div>
            <h1 style="color: #0f172a; margin: 0; font-size: 24px;">Reporte de Vehículos</h1>
            <p style="color: #64748b; margin: 5px 0 0 0; font-size: 13px;">Vehículos filtrados del sistema</p>
        </div>
        <div style="text-align: right; color: #64748b; font-size: 12px;">
            Fecha de generación<br />
            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>

    <table style="width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1;">
        <thead>
            <tr style="background-color: #0f172a; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
                <th style="padding: 12px 10px; border: 1px solid #cbd5e1; color: white; text-align: center; font-size: 12px;">VIN</th>
                <th style="padding: 12px 10px; border: 1px solid #cbd5e1; color: white; text-align: center; font-size: 12px;">Vehículo</th>
                <th style="padding: 12px 10px; border: 1px solid #cbd5e1; color: white; text-align: center; font-size: 12px;">Cliente</th>
                <th style="padding: 12px 10px; border: 1px solid #cbd5e1; color: white; text-align: center; font-size: 12px;">Estado</th>
                <th style="padding: 12px 10px; border: 1px solid #cbd5e1; color: white; text-align: center; font-size: 12px;">Año</th>
                <th style="padding: 12px 10px; border: 1px solid #cbd5e1; color: white; text-align: center; font-size: 12px;">Costo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                string bgBadge = "#3b82f6";
                switch (v.Estado?.NombreEstado)
                {
                    case "En tránsito": bgBadge = "#06b6d4"; break;
                    case "En aduana": bgBadge = "#eab308"; break;
                    case "En preparación": bgBadge = "#8b5cf6"; break;
                    case "Trámites pendientes": bgBadge = "#ef4444"; break;
                    case "Listo para entrega": bgBadge = "#3b82f6"; break;
                    case "Entregado": bgBadge = "#22c55e"; break;
                }

                string bgFila = Model.IndexOf(v) % 2 == 0 ? "#ffffff" : "#f8fafc";

                <tr style="background-color: @bgFila; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
                    <td style="padding: 12px 10px; border: 1px solid #cbd5e1; text-align: center; font-size: 12px;">@v.Vin</td>
                    <td style="padding: 12px 10px; border: 1px solid #cbd5e1; text-align: center; font-size: 12px;">@v.Marca @v.Modelo</td>
                    <td style="padding: 12px 10px; border: 1px solid #cbd5e1; text-align: center; font-size: 12px;">@(v.Cliente != null ? $"{v.Cliente.Nombre} {v.Cliente.Apellido}" : "Sin asignar")</td>
                    <td style="padding: 12px 10px; border: 1px solid #cbd5e1; text-align: center; font-size: 12px;">
                        <span style="display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; color: white; background-color: @bgBadge; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
                            @(v.Estado?.NombreEstado ?? "Desconocido")
                        </span>
                    </td>
                    <td style="padding: 12px 10px; border: 1px solid #cbd5e1; text-align: center; font-size: 12px;">@v.Anio</td>
                    <td style="padding: 12px 10px; border: 1px solid #cbd5e1; text-align: center; font-size: 12px;">$@v.Costo</td>
                </tr>
            }
        </tbody>
    </table>

    <div style="margin-top: 20px; text-align: center; color: #94a3b8; font-size: 11px;">
        Importames © @DateTime.Now.Year
    </div>

    <script>
            function imprimirReporte() {
                document.getElementById('contenedor-boton').style.display = 'none';
                window.print();
                setTimeout(function () {
                    document.getElementById('contenedor-boton').style.display = 'block';
                }, 500);
            }
    </script>
</body>
</html>